    "event": "register_export.completed",
    "trigger": "register-export-completed",
    "name": "Register export completed",
    "description": "Staff in-app and email when an export is ready.",
    "tags": [
      "openg2p",
      "registry"
    ],
    "payload_schema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "export_format": {
          "type": "string"
        },
        "register_mnemonic": {
          "type": "string"
        },
        "total_records_exported": {
          "type": "string"
        },
        "file_url_expires_at": {
          "type": "string"
        },
        "file_presigned_url": {
          "type": "string"
        },
        "staff_portal_base_url": {
          "type": "string"
        }
      }
    },
    "steps": [
      {
        "name": "In-App",
        "type": "in_app",
        "controlValues": {
          "subject": "Export ready",
          "body": "Your {{payload.export_format}} export of {{payload.register_mnemonic}} is ready. {{payload.total_records_exported}} records were exported.",
          "primaryAction": {
            "label": "Open register",
            "redirect": {
              "url": "{{payload.staff_portal_base_url}}/en/register/{{payload.register_mnemonic}}",
              "target": "_self"
            }
          }
        }
      },
      {
        "name": "Email",
        "type": "email",
        "controlValues": {
          "subject": "Export ready",
          "body": "<p>Your {{payload.export_format}} export of {{payload.register_mnemonic}} is ready. {{payload.total_records_exported}} records were exported. The download link expires at {{payload.file_url_expires_at}}.</p><p><a href=\"{{payload.file_presigned_url}}\">Download</a></p>",
          "editorType": "html"
        }
      }
    ]
  },
