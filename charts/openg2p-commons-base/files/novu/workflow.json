  {
    "event": "approval.stage_started",
    "trigger": "approval-stage-started",
    "name": "Approval stage started",
    "description": "Staff in-app and email to a stage's approvers when the stage activates.",
    "tags": [
      "openg2p",
      "awe"
    ],
    "payload_schema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "request_id": {
          "type": "string"
        },
        "artifact_type": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "stage_name": {
          "type": "string"
        },
        "stage_order": {
          "type": "string"
        },
        "policy_key": {
          "type": "string"
        },
        "source_service": {
          "type": "string"
        },
        "requester": {
          "type": "string"
        },
        "due_at": {
          "type": "string"
        },
        "staff_portal_base_url": {
          "type": "string"
        },
        "task_path": {
          "type": "string"
        },
        "tasks_list_path": {
          "type": "string"
        },
        "register_mnemonic": {
          "type": "string"
        }
      }
    },
    "steps": [
      {
        "name": "In-App",
        "type": "in_app",
        "controlValues": {
          "subject": "Approval needed: {{payload.stage_name}}",
          "body": "Stage {{payload.stage_name}} of {{payload.artifact_type}} {{payload.artifact_id}} needs your approval. Request {{payload.request_id}}.{% if payload.due_at %} Due by {{payload.due_at}}.{% endif %}",
          "primaryAction": {
            "label": "View task",
            "redirect": {
              "url": "{{payload.staff_portal_base_url}}/en{{payload.task_path}}",
              "target": "_self"
            }
          },
          "secondaryAction": {
            "label": "Show all tasks",
            "redirect": {
              "url": "{{payload.staff_portal_base_url}}/en{{payload.tasks_list_path}}",
              "target": "_self"
            }
          }
        }
      },
      {
        "name": "Email",
        "type": "email",
        "controlValues": {
          "subject": "Approval needed: {{payload.stage_name}}",
          "body": "<p>Stage {{payload.stage_name}} of {{payload.artifact_type}} {{payload.artifact_id}} needs your approval. Request {{payload.request_id}}.{% if payload.due_at %} Due by {{payload.due_at}}.{% endif %}</p><p><a href=\"{{payload.staff_portal_base_url}}/en{{payload.task_path}}\">View task</a></p>",
          "editorType": "html"
        }
      }
    ]
  },
