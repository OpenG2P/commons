[
  {
    "event": "change_request.created",
    "trigger": "change-request-created",
    "name": "Change request created",
    "description": "Registrant email and SMS when a change request is created.",
    "tags": [
      "openg2p",
      "registry"
    ],
    "payload_schema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "record_name": {
          "type": "string"
        },
        "change_request_id": {
          "type": "string"
        },
        "register_mnemonic": {
          "type": "string"
        }
      }
    },
    "steps": [
      {
        "name": "Email",
        "type": "email",
        "controlValues": {
          "subject": "Change request received",
          "body": "<p>We received a change request for {{payload.record_name}}. We will email you when it is approved or rejected.</p>",
          "editorType": "html"
        }
      },
      {
        "name": "SMS",
        "type": "sms",
        "controlValues": {
          "body": "Change request received. We received a change request for {{payload.record_name}}. We will message you when it is approved or rejected."
        }
      }
    ]
  },
  {
    "event": "change_request.approved",
    "trigger": "change-request-approved",
    "name": "Change request approved",
    "description": "Registrant email and SMS when a change request is approved.",
    "tags": [
      "openg2p",
      "registry"
    ],
    "payload_schema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "record_name": {
          "type": "string"
        },
        "change_request_id": {
          "type": "string"
        },
        "register_mnemonic": {
          "type": "string"
        }
      }
    },
    "steps": [
      {
        "name": "Email",
        "type": "email",
        "controlValues": {
          "subject": "Change request approved",
          "body": "<p>The change request for {{payload.record_name}} was approved.</p>",
          "editorType": "html"
        }
      },
      {
        "name": "SMS",
        "type": "sms",
        "controlValues": {
          "body": "Change request approved. The change request for {{payload.record_name}} was approved."
        }
      }
    ]
  },
  {
    "event": "change_request.rejected",
    "trigger": "change-request-rejected",
    "name": "Change request rejected",
    "description": "Registrant email and SMS when a change request is rejected.",
    "tags": [
      "openg2p",
      "registry"
    ],
    "payload_schema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "record_name": {
          "type": "string"
        },
        "rejection_reason": {
          "type": "string"
        },
        "change_request_id": {
          "type": "string"
        },
        "register_mnemonic": {
          "type": "string"
        }
      }
    },
    "steps": [
      {
        "name": "Email",
        "type": "email",
        "controlValues": {
          "subject": "Change request rejected",
          "body": "<p>The change request for {{payload.record_name}} was rejected. {% if payload.rejection_reason %}Reason: {{payload.rejection_reason}}.{% endif %}</p>",
          "editorType": "html"
        }
      },
      {
        "name": "SMS",
        "type": "sms",
        "controlValues": {
          "body": "Change request rejected. The change request for {{payload.record_name}} was rejected. {% if payload.rejection_reason %}Reason: {{payload.rejection_reason}}.{% endif %}"
        }
      }
    ]
  },
